# Server configuration
PORT=3000
NODE_ENV=development

# Firebase configuration (client-side uses firebase-applet-config.json)
FIREBASE_API_KEY=

# Gemini API configuration (server-side if applicable)
GEMINI_API_KEY=

# ---- E-mail API for the Finance Health Check-up PDF report ----
# 1. Create a free account at https://www.brevo.com
# 2. Brevo -> Senders & IP -> Senders: add and verify the address reports are sent from (a Gmail address works)
# 3. Brevo -> SMTP & API -> API Keys -> Generate a new API key, and paste it below
# Only BREVO_API_KEY is required: the sender defaults to jeyaprakash27052005@gmail.com (verify it in Brevo, step 2).
# Copy this file to ".env" for local use. On Vercel add the same 3 names under Project -> Settings -> Environment Variables
# (Admin, Customer and Health Check-up projects), then redeploy. NEVER commit the real key to GitHub.
BREVO_API_KEY=""
REPORT_FROM_EMAIL="jeyaprakash27052005@gmail.com"
REPORT_FROM_NAME="Finance Health Check-up"

# ---- Automatic WhatsApp / SMS of the health check-up report (Message mode) ----
# WhatsApp (Meta WhatsApp Cloud API: developers.facebook.com -> create app -> WhatsApp). PDF + full report text.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
# Approved message template with a DOCUMENT header and two body variables ({{1}} name, {{2}} score). Needed to reach customers
# who have not messaged your number in the last 24 hours.
WHATSAPP_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="en"
# SMS (Twilio) - used when WhatsApp is not set up or fails. Short text with score and first step (SMS cannot carry the PDF).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
