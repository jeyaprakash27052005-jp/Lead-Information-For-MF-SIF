# Server configuration
PORT=3000
NODE_ENV=development

# Firebase configuration (client-side uses firebase-applet-config.json)
FIREBASE_API_KEY=

# Gemini API configuration (server-side if applicable)
GEMINI_API_KEY=

# E-mail for the Finance Health Check-up report (set these on the Vercel project, not in the code)
BREVO_API_KEY=""
REPORT_FROM_EMAIL=""
REPORT_FROM_NAME="Finance Health Check-up"
