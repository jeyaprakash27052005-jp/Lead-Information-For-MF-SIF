rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId)
        && request.resource.data.username is string && request.resource.data.username.size() <= 64
        && request.resource.data.name is string && request.resource.data.name.size() <= 128
        && request.resource.data.designation is string && request.resource.data.designation.size() <= 128
        && request.resource.data.role in ['head', 'regional_incharge', 'area_incharge', 'customer']
        && request.resource.data.region is string && request.resource.data.region.size() <= 128
        && request.resource.data.status in ['active', 'inactive'];
      allow delete: if isValidId(userId);
    }

    match /leads/{leadId} {
      allow get, list: if true;
      allow create, update: if isValidId(leadId)
        && request.resource.data.name is string && request.resource.data.name.size() <= 128
        && request.resource.data.age is number && request.resource.data.age >= 0 && request.resource.data.age <= 150
        && request.resource.data.gender in ['Male', 'Female', 'Other']
        && request.resource.data.annualIncome is number && request.resource.data.annualIncome >= 0
        && request.resource.data.occupation is string && request.resource.data.occupation.size() <= 128
        && request.resource.data.status in ['Pending', 'Ready to Invest', 'Process', 'Other']
        && request.resource.data.addedByName is string && request.resource.data.addedByName.size() <= 128
        && request.resource.data.addedByDesignation is string && request.resource.data.addedByDesignation.size() <= 128
        && request.resource.data.assignedRegion is string && request.resource.data.assignedRegion.size() <= 128
        && (!('mobile' in request.resource.data) || (request.resource.data.mobile is string && request.resource.data.mobile.matches('^[6-9][0-9]{9}$')))
        && (!('panNumber' in request.resource.data) || (request.resource.data.panNumber is string && request.resource.data.panNumber.matches('^[A-Z]{5}[0-9]{4}[A-Z]$')))
        && (!('panAvailable' in request.resource.data) || request.resource.data.panAvailable is bool)
        && (!('dematAvailable' in request.resource.data) || request.resource.data.dematAvailable is bool)
        && (!('kycComplete' in request.resource.data) || request.resource.data.kycComplete is bool)
        && (!('sipAutopayActive' in request.resource.data) || request.resource.data.sipAutopayActive is bool);
      allow delete: if isValidId(leadId);
    }

    match /schemes/{schemeId} {
      allow get, list: if true;
      allow create, update: if isValidId(schemeId)
        && request.resource.data.name is string && request.resource.data.name.size() <= 128
        && request.resource.data.type in ['mutual_fund', 'nps']
        && request.resource.data.category is string;
      allow delete: if isValidId(schemeId);
    }

    match /regions/{regionId} {
      allow get, list: if true;
      allow create, update: if isValidId(regionId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 64;
      allow delete: if isValidId(regionId);
    }

    match /ads/{adId} {
      allow get, list: if true;
      allow create, update: if isValidId(adId)
        && request.resource.data.title is string
        && request.resource.data.imageUrl is string
        && request.resource.data.isActive is bool;
      allow delete: if isValidId(adId);
    }

    match /fundAds/{adId} {
      allow get, list: if true;
      allow create, update: if isValidId(adId)
        && request.resource.data.fundName is string && request.resource.data.fundName.size() > 0 && request.resource.data.fundName.size() <= 160
        && request.resource.data.headline is string && request.resource.data.headline.size() <= 200
        && request.resource.data.imageUrl is string
        && request.resource.data.isActive is bool;
      allow delete: if isValidId(adId);
    }

    match /siteMenus/{menuId} {
      allow get, list: if true;
      allow create, update: if isValidId(menuId)
        && request.resource.data.label is string && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 60
        && request.resource.data.isActive is bool;
      allow delete: if isValidId(menuId);
    }

    match /siteItems/{itemId} {
      allow get, list: if true;
      allow create, update: if isValidId(itemId)
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.menuId is string
        && request.resource.data.kind in ['page', 'link', 'route', 'calculator']
        && request.resource.data.isActive is bool;
      allow delete: if isValidId(itemId);
    }

    match /awarenessPrograms/{programId} {
      allow get, list: if true;
      allow create, update: if isValidId(programId)
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.description is string && request.resource.data.description.size() <= 3000
        && request.resource.data.startsAt is string
        && request.resource.data.mode in ['online', 'offline']
        && request.resource.data.isActive is bool;
      allow delete: if isValidId(programId);
    }

    match /healthReports/{reportId} {
      allow get, list: if true;
      allow create, update: if isValidId(reportId)
        && request.resource.data.name is string && request.resource.data.name.size() <= 128
        && request.resource.data.age is number && request.resource.data.age >= 0 && request.resource.data.age <= 150
        && request.resource.data.gender in ['Male', 'Female', 'Other']
        && request.resource.data.annualIncome is number && request.resource.data.annualIncome >= 0
        && request.resource.data.overallScore is number && request.resource.data.overallScore >= 0 && request.resource.data.overallScore <= 100
        && request.resource.data.answers is map
        && request.resource.data.source in ['health_portal', 'customer_portal']
        && (!('mobile' in request.resource.data) || (request.resource.data.mobile is string && request.resource.data.mobile.matches('^[6-9][0-9]{9}$')))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120));
      allow delete: if isValidId(reportId);
    }

    match /settings/{docId} {
      allow get, list: if true;
      allow create, update: if (docId == 'app'
          && request.resource.data.features is map
          && request.resource.data.mfReturnRate is number && request.resource.data.mfReturnRate > 0 && request.resource.data.mfReturnRate <= 100
          && request.resource.data.npsReturnRate is number && request.resource.data.npsReturnRate > 0 && request.resource.data.npsReturnRate <= 100)
        || (docId == 'healthCheck'
          && request.resource.data.categories is list && request.resource.data.categories.size() <= 30
          && request.resource.data.questions is list && request.resource.data.questions.size() <= 200);
      allow delete: if false;
    }

    match /test/{docId} {
      allow get, list, write: if true;
    }
  }
}
